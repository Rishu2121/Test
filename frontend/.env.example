# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Application Configuration
NEXT_PUBLIC_APP_NAME=Job Importer
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_DESCRIPTION=AI/Job Importer System Dashboard

# Environment
NODE_ENV=development
NEXT_PUBLIC_ENV=development

# Features
NEXT_PUBLIC_ENABLE_POLLING=true
NEXT_PUBLIC_POLLING_INTERVAL=30000
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_REAL_TIME_UPDATES=false

# Authentication
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_REQUIRE_AUTH=false
NEXT_PUBLIC_AUTH_PROVIDER=local

# Theme
NEXT_PUBLIC_THEME=light
NEXT_PUBLIC_ENABLE_THEME_SWITCH=true

# Analytics (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Performance
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=false
NEXT_PUBLIC_CACHE_STRATEGY=network-first

# Debugging
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_LOG_LEVEL=warn

# Social Login (optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# Maps (optional for job locations)
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# File Upload
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_ALLOWED_FILE_TYPES=json,xml,csv

# Pagination
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
NEXT_PUBLIC_MAX_PAGE_SIZE=100

# Search Configuration
NEXT_PUBLIC_SEARCH_DEBOUNCE_MS=300
NEXT_PUBLIC_MIN_SEARCH_LENGTH=2

# Chart Defaults
NEXT_PUBLIC_CHART_COLORS="#3b82f6,#ef4444,#10b981,#f59e0b,#8b5cf6,#ec4899"
NEXT_PUBLIC_CHART_ANIMATION=true

# Date/Time Formatting
NEXT_PUBLIC_TIMEZONE=UTC
NEXT_PUBLIC_DATE_FORMAT=MM/dd/yyyy
NEXT_PUBLIC_TIME_FORMAT=HH:mm:ss

# API Keys (public only)
NEXT_PUBLIC_PUBLIC_API_KEY=your-public-api-key

# External Services
NEXT_PUBLIC_HELP_URL=https://docs.jobimporter.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@jobimporter.com
NEXT_PUBLIC_FEEDBACK_URL=https://feedback.jobimporter.com

# Development
NEXT_PUBLIC_DEVTOOLS=true
NEXT_PUBLIC_SHOW_WATERMARK=false

# Production Overrides
# NEXT_PUBLIC_API_URL=https://api.jobimporter.com
# NEXT_PUBLIC_WS_URL=wss://api.jobimporter.com
# NODE_ENV=production
# NEXT_PUBLIC_ENV=production
# NEXT_PUBLIC_DEBUG=false
# NEXT_PUBLIC_LOG_LEVEL=error
# NEXT_PUBLIC_DEVTOOLS=false