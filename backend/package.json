  "description": "Backend API for AI/Job Importer System with Redis queue processing",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "worker": "node workers/index.js",
    "worker:dev": "nodemon workers/index.js",
