# Database Configuration
MONGODB_URI=mongodb://localhost:27017/job-importer
MONGODB_TEST_URI=mongodb://localhost:27017/job-importer-test

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# API Configuration
PORT=3001
NODE_ENV=development
API_RATE_LIMIT=100
API_TIMEOUT=30000

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Worker Configuration
WORKER_CONCURRENCY=5
BATCH_SIZE=100
QUEUE_MAX_SIZE=10000
QUEUE_CLEANUP_INTERVAL=3600000

# External API Keys (encrypted - replace with actual keys)
# To encrypt: echo -n "your-api-key" | openssl enc -aes-256-cbc -base64 -pass pass:your-encryption-password
# To decrypt: echo "encrypted-string" | openssl enc -aes-256-cbc -base64 -d -pass pass:your-encryption-password
JOB_API_KEY_1=encrypted-api-key-1-replace-with-actual
JOB_API_KEY_2=encrypted-api-key-2-replace-with-actual
ENCRYPTION_PASSWORD=your-encryption-password

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@jobimporter.com

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=json,xml,csv

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
SESSION_SECRET=your-session-secret-change-this-in-production
BCRYPT_ROUNDS=12

# Monitoring and Analytics
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30000

# Development
ENABLE_CORS=true
ENABLE_MORGAN_LOGGING=true
ENABLE_COMPRESSION=true
TRUST_PROXY=false

# Production
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
# CLUSTER_MODE=false
# CLUSTER_WORKERS=0

# Feature Flags
ENABLE_REAL_TIME_UPDATES=false
ENABLE_BULK_OPERATIONS=true
ENABLE_ADVANCED_SEARCH=true
ENABLE_DATA_EXPORT=true
ENABLE_WEBHOOKS=false

# Performance
CACHE_TTL=300
MAX_CACHE_SIZE=1000
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT=10000

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_INTERVAL=86400000
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# Webhook Configuration (if enabled)
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_TIMEOUT=10000

# Social Login (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Analytics (optional)
GOOGLE_ANALYTICS_ID=GA-XXXXXXXX-X
SENTRY_DSN=your-sentry-dsn